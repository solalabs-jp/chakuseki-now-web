{
  "firestore": {
    "database": "(default)",
    "location": "asia-northeast1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix functions run lint",
        "npm --prefix functions run build"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/student/beacon",
        "function": {
          "functionId": "studentBeacon",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/student/answer",
        "function": {
          "functionId": "studentAnswer",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/student/attendance-calendar",
        "function": {
          "functionId": "studentAttendanceCalendar",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/student/attendance-summary",
        "function": {
          "functionId": "studentAttendanceSummary",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/student/timetable",
        "function": {
          "functionId": "studentTimetable",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/teacher/attendance-record",
        "function": {
          "functionId": "teacherAttendanceRecord",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/teacher/question",
        "function": {
          "functionId": "teacherQuestion",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/teacher/schedule-teacher",
        "function": {
          "functionId": "teacherScheduleTeacher",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/teacher/attendance-book",
        "function": {
          "functionId": "teacherAttendanceBook",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/teacher/register-beacon",
        "function": {
          "functionId": "teacherRegisterBeacon",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/auth/login",
        "function": {
          "functionId": "loginWithEmailPassword",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/generate-daily-sessions",
        "function": {
          "functionId": "adminGenerateDailySessions",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "database": {
      "port": 9000
    },
    "hosting": {
      "port": 5005
    },
    "eventarc": {
      "port": 9299
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  },
  "extensions": {},
  "apphosting": {
    "backendId": "default",
    "rootDir": "/"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  }
}
